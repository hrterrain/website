# Hostinger (Apache/LiteSpeed) settings — the counterpart of vercel.json.

Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # https and the bare domain only
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # source, notes and working folders that sit in the repo but are not part of the site
  RewriteRule ^(?:\.git|\.cache|\.github|archive|brand-source|supabase|\.playwright-mcp|\.netlify)(?:/|$) - [R=404,L]
  RewriteRule ^(?:README\.md|vercel\.json|\.vercelignore|\.gitignore|api/news\.mjs)$ - [R=404,L]
  RewriteRule \.(?:mp4|mov|md)$ - [R=404,L]

  # the compliance news feed
  RewriteRule ^api/news/?$ api/news.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(?:png|svg|ico|js|webp|jpg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
